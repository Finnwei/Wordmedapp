# --- Nunca, bajo ningún concepto ---
# La clave de firma del APK. Si se filtra, cualquiera puede publicar
# una actualización que Android acepte como si fuera nuestra.
*.jks
*.keystore
*.p12
key.properties
firma/

# --- Salidas generadas que se rehacen solas ---
# El canvas de diseño se vuelve a armar desde los .dc.html (2,6 MB).
diseno/interfaz-wordmed.html

# Skills de terceros: se reinstalan con `npx skills` según skills-lock.json.
.claude/skills/

# --- Herramientas ---
node_modules/
__pycache__/
*.pyc

# --- Basura del sistema ---
Thumbs.db
desktop.ini
.DS_Store

# --- Android ---
# Salidas de compilación y rutas propias de esta máquina.
android/build/
android/app/build/
android/.gradle/
android/local.properties
*.apk
*.aab
